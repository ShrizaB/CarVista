# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://carvista_user:carvista_pass@localhost:5432/carvista
PGSSL=false

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Free Map APIs (no key required)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_USER_AGENT=CarVista-Carpooling-App/1.0 (contact@example.com)

# Payments - Razorpay TEST MODE (sandbox keys, no real money moves)
# Create a free test account at https://dashboard.razorpay.com/ to get test keys.
# If left blank, the app automatically falls back to an internal mock payment
# gateway so the full payment flow still works end-to-end without any signup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
